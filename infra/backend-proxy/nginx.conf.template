# infra/backend-proxy/nginx.conf.template
# Renderizado pelo entrypoint com envsubst (apenas PORT e BACKEND_PROXY_SECRET).
# O backend escuta em 127.0.0.1:3001; o health sidecar em 127.0.0.1:3002.

map "$request_method:$uri" $deny_user_dump {
    default 0;
    "GET:/user" 1;
    "GET:/user/" 1;
}

server {
    listen ${PORT};
    server_name _;
    server_tokens off;
    client_max_body_size 2m;

    # 200 só quando o backend (e o Mongo em memória) responde.
    location = /health {
        proxy_pass http://127.0.0.1:3002/health;
        proxy_connect_timeout 2s;
        proxy_read_timeout 4s;
        access_log off;
    }

    # Swagger nunca é público.
    location ^~ /docs {
        return 404;
    }

    location / {
        # Bloqueia o dump de usuários (GET /user), mesmo com o segredo.
        if ($deny_user_dump) { return 404; }

        # Preflight de navegador não é usado pelo BFF; nega.
        if ($request_method = OPTIONS) { return 403; }

        # Só o BFF (que conhece o segredo) passa.
        if ($http_x_bff_secret != "${BACKEND_PROXY_SECRET}") { return 403; }

        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # O backend não precisa ver o segredo.
        proxy_set_header x-bff-secret "";
        # O backend responde CORS *; removemos para o navegador não ler.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Credentials;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_connect_timeout 5s;
        proxy_read_timeout 65s;
        proxy_send_timeout 65s;
    }
}
