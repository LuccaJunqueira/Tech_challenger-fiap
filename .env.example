# Copie este arquivo para `.env` e preencha com valores reais.
# Nunca comite `.env` nem segredos reais.

# Obrigatório: mínimo de 32 caracteres. Rotacionar invalida todas as sessões.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Origens exatas permitidas nas mutações do BFF (sem path e sem barra final).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# URL interna do backend vista pelo servidor Next.js.
INTERNAL_API_URL=http://localhost:3002
