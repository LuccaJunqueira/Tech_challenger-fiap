# Copie este arquivo para `.env` e preencha com valores reais.
# Nunca comite `.env` nem segredos reais.

# Obrigatório: mínimo de 32 caracteres. Rotacionar invalida todas as sessões.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Origens exatas permitidas nas mutações do BFF (sem path e sem barra final).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# URL interna do backend vista pelo servidor Next.js.
INTERNAL_API_URL=http://localhost:3002

# Segredo enviado pelo BFF no header x-bff-secret (obrigatório em produção).
BACKEND_PROXY_SECRET=replace-with-a-long-random-secret

# URL da zona app usada pelos rewrites da home (build da home).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# URL absoluta da home usada nos redirects do app (build do app).
NEXT_PUBLIC_HOME_URL=http://localhost:3000

# Opcional: sobrescreve o timeout do BFF (default: 5 s em dev, 45 s em produção).
BACKEND_TIMEOUT_MS=45000
